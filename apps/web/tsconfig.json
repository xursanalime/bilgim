{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@edubridge/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@edubridge/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@edubridge/i18n": [
        "../../packages/i18n/src/index.ts"
      ],
      "@edubridge/i18n/*": [
        "../../packages/i18n/*"
      ]
    },
    "isolatedModules": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
