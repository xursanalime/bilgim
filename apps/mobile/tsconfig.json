{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-native",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "@edubridge/api-client": ["../../packages/api-client/src/index.ts"],
      "@edubridge/i18n": ["../../packages/i18n/src/index.ts"],
      "@edubridge/i18n/*": ["../../packages/i18n/*"],
      "@edubridge/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app.config.ts"
  ],
  "exclude": ["node_modules", ".expo"]
}
