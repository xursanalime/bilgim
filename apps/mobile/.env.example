# Bilgim Mobile — Expo public env vars
# All EXPO_PUBLIC_* vars are inlined into the bundle, do not put secrets here.
#
# Point this at the API root (the client appends `/api/v1` automatically).
#
# Emulator notes:
#   Android emulator → http://10.0.2.2:4000
#   iOS simulator    → http://localhost:4000
#   Physical device  → http://<your LAN IP>:4000

EXPO_PUBLIC_API_URL=http://localhost:4000
