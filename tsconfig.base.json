{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@edubridge/db": ["packages/db/src/index.ts"],
      "@edubridge/shared-types": ["packages/shared-types/src/index.ts"],
      "@edubridge/api-client": ["packages/api-client/src/index.ts"],
      "@edubridge/ui": ["packages/ui/src/index.ts"],
      "@edubridge/config": ["packages/config/src/index.ts"],
      "@edubridge/i18n": ["packages/i18n/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
