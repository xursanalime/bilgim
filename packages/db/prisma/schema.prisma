/// PushDevice — registered Expo push token for a user's device
/// (Task 22.2, Req 16.1).
///
/// One row per active token. The same `User` may register tokens for
/// multiple devices (phone + tablet); the `(userId, token)` unique
/// constraint dedupes re-registration of the same token (a common case
/// when the app re-asks for permission on every cold boot).
///
/// `platform` is the OS reported by `expo-device` at registration time
/// (`ios`, `android`, `web`). The mobile app sends `expo-device`
/// metadata in `deviceInfo` so admins can debug push failures
/// (model name, OS version) without tying us to a specific schema.
///
/// `revokedAt` is set when the Expo Push API returns
/// `DeviceNotRegistered` for a token. The push processor reads only
/// rows with `revokedAt IS NULL` so a stale token cannot keep
/// generating receipts.
model PushDevice {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  platform   String
  deviceInfo Json?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, token])
  @@index([userId, revokedAt])
}

