// ============ MEDIA ============

model MediaAsset {
  id             String      @id @default(uuid()) @db.Uuid
  ownerUserId    String      @db.Uuid
  kind           MediaKind
  status         AssetStatus @default(UPLOADING)
  bytes          BigInt?
  contentType    String?
  originalKey    String?
  hlsManifestKey String?
  thumbnailKey   String?
  durationMs     Int?
  metadata       Json?
  /// Content-protection (content-protection-backend, Req 2.5). `drmPackaged`
  /// flips true once the asset has been encrypted/packaged by the DRM_Provider
  /// (or the dev fallback); `providerAssetId` is the vendor-side asset handle
  /// used to broker manifests/licenses. Both null until protection is wired.
  drmPackaged    Boolean     @default(false)
  providerAssetId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  attachments      Attachment[]
  recordings       Recording[]
  transcodingJobs  TranscodingJob[]
  playbackSessions PlaybackSession[]
}

/// Per-viewer playback session for forensic traceability
/// (content-protection-backend, Req 3.1, 6.1, 6.2). One row per issued
/// Playback_Ticket: binds the authenticated viewer to an asset/lesson and the
/// watermark identity (`viewerTag`) so a leaked recording can be traced back to
/// a learner. Retention is configurable (Req 6.2).
model PlaybackSession {
  id           String     @id @default(uuid()) @db.Uuid
  assetId      String     @db.Uuid
  asset        MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  lessonId     String?    @db.Uuid
  viewerUserId String     @db.Uuid
  enrollmentId String?    @db.Uuid
  /// Forensic watermark label derived server-side from the auth session.
  viewerTag    String
  drmKeySystem String?
  ip           String?
  userAgent    String?
  issuedAt     DateTime   @default(now())
  expiresAt    DateTime

  @@index([viewerTag])
  @@index([assetId, issuedAt])
  @@index([viewerUserId, issuedAt])
}

model TranscodingJob {
  id         String     @id @default(uuid()) @db.Uuid
  assetId    String     @db.Uuid
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status     String
  attempt    Int        @default(0)
  errorMsg   String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([status, createdAt])
}

