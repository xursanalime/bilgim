// packages/db/prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, citext]
}

// ============ ENUMS ============

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFY
  ACTIVE
  SUSPENDED
  DELETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymeTxState {
  PENDING
  CREATED
  PAID
  CANCELED
  CANCELED_AFTER_PAY
}

enum LessonType {
  RECORDED
  LIVE
  HYBRID
  TEXT_ONLY
}

enum LessonStatus {
  DRAFT
  READY
  ARCHIVED
}

enum LiveSessionStatus {
  SCHEDULED
  STARTING
  LIVE
  ENDED
  RECORDING_FAILED
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVOKED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  GRADED
  RETURNED
}

enum HomeworkModuleType {
  // Language-learning modules
  WRITING
  READING
  LISTENING
  GRAMMAR
  SPELLING
  VOCABULARY
  SPEAKING
  PRONUNCIATION
  // Generic interactive question types
  MULTIPLE_CHOICE
  GAP_FILL
  MATCHING
  DRAG_DROP
  // Project / case-based modules
  PROJECT_SUBMISSION
  CASE_STUDY
  MARKETING_COPY
  AUDIENCE_ANALYSIS
  CONTENT_CALENDAR
  // Math modules
  MATH_WORD_PROBLEM
  MATH_EQUATION_SOLVER
  MATH_GEOMETRY_PROOF
  // Code modules
  CODE_REVIEW
  CODE_UNIT_TEST
}

/// CEFR proficiency levels (Common European Framework of Reference for Languages).
enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum AiIntent {
  TUTOR_EXPLAIN
  TUTOR_TRANSLATE
  TUTOR_EXAMPLE
  GRADE_PRECHECK
  AI_TEXT_DETECT
  SPECIALTY_CLASSIFY
  AI_CHAT
  GENERATE_TEST
  SUGGEST_RUBRIC
  TRANSLATE_WORD
  TRANSLATE_SENTENCE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
  PUSH
  SMS
}

enum NotificationKind {
  ENROLLMENT_REQUESTED
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  LESSON_PUBLISHED
  SCHEDULE_CHANGED
  LIVE_STARTED
  LIVE_REMINDER
  HOMEWORK_ASSIGNED
  HOMEWORK_GRADED
  AI_REVIEW_READY
  TRIAL_ENDING
  SUBSCRIPTION_PAST_DUE
  GAMIFICATION_LEVEL_UP
}

enum MediaKind {
  VIDEO
  AUDIO
  IMAGE
  PDF
  DOC
  SHEET
  RECORDING
  OTHER
}

enum AssetStatus {
  UPLOADING
  UPLOADED
  TRANSCODING
  READY
  FAILED
}

enum MfaType {
  TOTP
  WEBAUTHN
}

// ============ AUTH / USERS ============

model User {
  id           String     @id @default(uuid()) @db.Uuid
  publicId     String?    @unique
  email        String     @unique @db.Citext
  username     String?    @unique
  phone        String?    @unique
  telegramChatId String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(PENDING_VERIFY)
  fullName     String
  avatarUrl    String?
  locale       String     @default("uz")
  location     String?
  mfaRequired  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  mfaCredentials     MfaCredential[]
  mfaBackupCodes     MfaBackupCode[]

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  pushDevices       PushDevice[]
  aiCalls           AiCall[]
  aiConversations   AiConversation[]
  auditLogs         AdminAuditLog[]
  dmReadReceipts    DmReadReceipt[]
  chatMemberships   ChatRoomMember[]

  gamificationProfile GamificationProfile?
  rewardPurchases     RewardPurchase[]

  @@index([role, status])
}

// ============ GAMIFICATION ============

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum BadgeCategory {
  LEARNING // O'rganish (student)
  TEACHING // O'qitish (teacher)
  SOCIAL   // Ijtimoiy
  SPECIAL  // Maxsus
}

model GamificationProfile {
  userId         String    @id @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole // STUDENT yoki TEACHER
  totalXp        Int       @default(0)
  weeklyXp       Int       @default(0) // Haftada reset
  currentLevel   Int       @default(1)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  freezesLeft    Int       @default(3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  xpEvents          XpEvent[]
  userBadges        UserBadge[]
  challengeProgress ChallengeProgress[]

  @@index([totalXp])
  @@index([weeklyXp])
}

model XpEvent {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String              @db.Uuid
  profile  GamificationProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  amount   Int
  reason   String // 'homework_submitted', 'live_attended', 'badge_earned', etc.
  metadata Json? // { assignmentId, lessonId, ... }
  earnedAt DateTime            @default(now())

  @@index([userId, earnedAt])
}

model Badge {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  nameUz        String
  nameRu        String
  nameEn        String
  descriptionUz String
  iconUrl       String
  rarity        BadgeRarity
  category      BadgeCategory
  xpReward      Int           @default(0)
  isActive      Boolean       @default(true)
  targetRole    UserRole? // null = hammaga, STUDENT = faqat student, TEACHER = faqat teacher
  createdAt     DateTime      @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String              @db.Uuid
  profile  GamificationProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  badgeId  String              @db.Uuid
  badge    Badge               @relation(fields: [badgeId], references: [id])
  earnedAt DateTime            @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model DailyChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  nameUz      String
  description String
  xpReward    Int
  targetCount Int // Necha marta bajarish kerak
  eventType   String // 'homework_submitted', 'live_attended', 'ai_tutor_used'
  targetRole  UserRole @default(STUDENT)

  progress ChallengeProgress[]

  @@unique([date, eventType, targetRole])
}

model ChallengeProgress {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  profile      GamificationProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  challengeId  String              @db.Uuid
  challenge    DailyChallenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  currentCount Int                 @default(0)
  completed    Boolean             @default(false)
  completedAt  DateTime?

  @@unique([userId, challengeId])
  @@index([userId])
}

model RewardItem {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nameUz      String
  description String
  xpCost      Int
  itemType    String // 'streak_freeze', 'profile_frame', 'badge_bg'
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases RewardPurchase[]
}

model RewardPurchase {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String     @db.Uuid
  item        RewardItem @relation(fields: [itemId], references: [id])
  xpSpent     Int
  purchasedAt DateTime   @default(now())

  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Multi-Factor Authentication credentials per user (Task 29.1).
/// One row per enrolled factor (TOTP authenticator app, WebAuthn key).
///
///  * `type`        — TOTP or WEBAUTHN
///  * `label`       — user-facing name ("iPhone", "YubiKey 5C")
///  * `secret`      — TOTP: encrypted base32 shared secret;
///                    WEBAUTHN: encrypted base64url public key (COSE)
///  * `credentialId`— WebAuthn credential id (base64url) — NULL for TOTP.
///                    Unique so two devices can't register the same key.
///  * `counter`     — WebAuthn signature counter (anti-clone replay).
///                    NULL for TOTP.
///  * `deviceInfo`  — JSON: AAGUID / transports / aaguid metadata for
///                    WebAuthn or app fingerprint for TOTP.
///  * `verifiedAt`  — set when the user proves possession during enrollment.
///  * `lastUsedAt`  — bumped after each successful challenge; also used to
///                    reject replays of the same TOTP code inside the 30s
///                    window.
model MfaCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         MfaType
  label        String?
  secret       String
  counter      BigInt?
  credentialId String?   @unique
  deviceInfo   Json?
  verifiedAt   DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, type])
}

/// Single-use MFA backup codes (Task 29.1).
/// Issued in batches of 10. Hashed with SHA-256 so a leaked DB does not
/// hand attackers a usable code. `usedAt` flips the row to consumed and
/// `expiresAt` (default 1 year) lets us prune stale codes.
model MfaBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

// ============ TEACHER ============

/// DEPRECATED (english-only-platform-refocus). READ-ONLY historical data.
/// The generic multi-specialty abstraction is retired: English is the single
/// supported subject. New flows MUST NOT read or write Specialty. Existing rows
/// are retained as read-only history per Requirement 16.5 and are NOT deleted
/// here. Permanent removal is handled by a SEPARATE future decommission step
/// (see packages/db/DECOMMISSION.md), not by this refocus.
model Specialty {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  nameUz       String
  nameRu       String
  nameEn       String
  isActive     Boolean  @default(true)
  dashboardKey String
  createdAt    DateTime @default(now())

  teachers  TeacherProfile[]
  questions OnboardingQuestion[]
  modules   SpecialtyModule[]
}

/// DEPRECATED (english-only-platform-refocus). READ-ONLY historical data.
/// Per-Specialty module catalog is replaced by a single global English (8-skill)
/// catalog. New flows MUST NOT read or write SpecialtyModule. Retained as
/// read-only history per Requirement 16.5; NOT deleted here. Permanent removal
/// is handled by a SEPARATE future decommission step (see
/// packages/db/DECOMMISSION.md).
///
/// Specialty <-> HomeworkModuleType mapping (admin-managed).
/// Per-Specialty hard cap: at most 10 rows with isActive = true per specialtyId.
/// Enforced at two layers:
///   1. Service-layer guard in the admin module before insert/update.
///   2. DB-level deferred constraint trigger enforce_specialty_module_cap()
model SpecialtyModule {
  specialtyId    String             @db.Uuid
  specialty      Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  moduleType     HomeworkModuleType
  isActive       Boolean            @default(true)
  defaultEnabled Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@id([specialtyId, moduleType])
  @@index([specialtyId, isActive])
}

model TeacherProfile {
  userId                String     @id @db.Uuid
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DEPRECATED (english-only-platform-refocus): the specialty link is kept only
  /// for historical data and is IGNORED by new flows (English is the single
  /// subject). Not removed here per Requirement 16.5; dropped by a separate
  /// future decommission step (see packages/db/DECOMMISSION.md).
  specialtyId           String?    @db.Uuid
  /// DEPRECATED (english-only-platform-refocus): retained for history only;
  /// ignored by new flows. See packages/db/DECOMMISSION.md.
  specialty             Specialty? @relation(fields: [specialtyId], references: [id])
  bio                   String?
  yearsOfExperience     Int?
  onboardingCompletedAt DateTime?
  createdAt             DateTime   @default(now())

  // Public discovery fields (Phase 5)
  publicSlug    String?  @unique
  headline      String?
  fullName      String?
  coverUrl      String?
  rating        Decimal? @db.Decimal(3, 2)
  studentsCount Int      @default(0)

  /// English-teaching attributes (english-only-platform-refocus, Req 10.3).
  /// The CEFR levels this instructor teaches (subset of A1–C2). Empty = not
  /// yet declared during onboarding.
  taughtCefrLevels CefrLevel[] @default([])
  /// Exam-preparation tracks this instructor focuses on, stored as
  /// `ExamTrack.slug` strings (e.g. ["ielts"]). Mirrors the no-FK string
  /// convention used by `Course.examTrack`. Empty = none declared.
  examTrackFocus   String[]    @default([])

  subscriptions     Subscription[]
  courses           Course[]
  onboardingAnswers OnboardingAnswer[]
  invoices          Invoice[]

  @@index([specialtyId])
}

/// DEPRECATED (english-only-platform-refocus). READ-ONLY historical data.
/// The onboarding-question-driven specialty classification flow is retired
/// (Req 2.5). New flows MUST NOT read or write OnboardingQuestion. Retained as
/// read-only history per Requirement 16.5; NOT deleted here. Permanent removal
/// is handled by a SEPARATE future decommission step (see
/// packages/db/DECOMMISSION.md).
model OnboardingQuestion {
  id          String     @id @default(uuid()) @db.Uuid
  specialtyId String?    @db.Uuid
  specialty   Specialty? @relation(fields: [specialtyId], references: [id])
  order       Int
  textUz      String
  textRu      String
  textEn      String
  optionsJson Json
  isActive    Boolean    @default(true)

  answers OnboardingAnswer[]

  @@index([specialtyId, order])
}

/// DEPRECATED (english-only-platform-refocus). READ-ONLY historical data.
/// Stores answers to the retired specialty-classification onboarding flow.
/// New flows MUST NOT read or write OnboardingAnswer. Retained as read-only
/// history per Requirement 16.5; NOT deleted here. Permanent removal is handled
/// by a SEPARATE future decommission step (see packages/db/DECOMMISSION.md).
model OnboardingAnswer {
  id                String             @id @default(uuid()) @db.Uuid
  teacherId         String             @db.Uuid
  teacher           TeacherProfile     @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  questionId        String             @db.Uuid
  question          OnboardingQuestion @relation(fields: [questionId], references: [id])
  selectedOptionId  String
  selectedOptionIds Json?
  createdAt         DateTime           @default(now())

  @@unique([teacherId, questionId])
}

model StudentProfile {
  userId          String     @id @db.Uuid
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth     DateTime?
  primaryLocale   String     @default("uz")
  bio             String?
  /// Current English proficiency. NULL = UNASSESSED (no placement completed yet).
  currentCefrLevel CefrLevel?

  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  submissions        Submission[]
  proficiencyHistory ProficiencyLevelHistory[]
  placementAssessments PlacementAssessment[]
}

/// Append-only history of a Learner's English proficiency level changes.
/// `fromLevel`/`toLevel` are nullable to represent UNASSESSED (no placement yet).
/// `source` records the origin of the change ('placement' | 'instructor' | 'migration').
model ProficiencyLevelHistory {
  id          String         @id @default(uuid()) @db.Uuid
  learnerId   String         @db.Uuid
  learner     StudentProfile @relation(fields: [learnerId], references: [userId], onDelete: Cascade)
  fromLevel   CefrLevel?
  toLevel     CefrLevel?
  source      String
  changedById String?        @db.Uuid
  changedAt   DateTime       @default(now())

  @@index([learnerId, changedAt])
}

/// A placement assessment session for a Learner. Resumable until submission (Req 5.4).
/// `status`: 'IN_PROGRESS' | 'SUBMITTED' | 'SCORED'.
/// `perSkillScores` stores per-skill scores (e.g. READING/GRAMMAR/VOCABULARY) as JSON.
/// `computedLevel` is the CEFR level derived from scored responses (NULL until scored).
model PlacementAssessment {
  id             String         @id @default(uuid()) @db.Uuid
  learnerId      String         @db.Uuid
  learner        StudentProfile @relation(fields: [learnerId], references: [userId], onDelete: Cascade)
  status         String         @default("IN_PROGRESS")
  perSkillScores Json?
  computedLevel  CefrLevel?
  startedAt      DateTime       @default(now())
  submittedAt    DateTime?

  answers PlacementAnswer[]

  @@index([learnerId, startedAt])
}

/// A single answer within a PlacementAssessment, persisted incrementally for resumption.
/// `skill` is one of READING/GRAMMAR/VOCABULARY; `questionRef` identifies the question.
model PlacementAnswer {
  id           String              @id @default(uuid()) @db.Uuid
  assessmentId String              @db.Uuid
  assessment   PlacementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skill        String
  questionRef  String
  answer       Json
  createdAt    DateTime            @default(now())

  @@unique([assessmentId, questionRef])
  @@index([assessmentId])
}

/// Admin-managed English examination preparation track (e.g. IELTS).
/// Course.examTrack references `slug` as a string for now (no FK, to avoid a breaking change).
model ExamTrack {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Plan {
  id           String  @id @default(uuid()) @db.Uuid
  slug         String  @unique
  nameUz       String
  priceUzs     Int
  intervalDays Int
  maxStudents  Int?
  features     Json
  isActive     Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  teacherId          String             @db.Uuid
  teacher            TeacherProfile     @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  planId             String?            @db.Uuid
  plan               Plan?              @relation(fields: [planId], references: [id])
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices Invoice[]

  // Partial unique index added via raw SQL migration:
  // Only one non-terminal (TRIAL/ACTIVE/PAST_DUE) subscription per teacher
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
  subscriptionId String?           @db.Uuid
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  teacherId      String?           @db.Uuid
  teacher        TeacherProfile?   @relation(fields: [teacherId], references: [userId])
  studentId      String?           @db.Uuid
  groupId        String?           @db.Uuid
  group          Group?            @relation(fields: [groupId], references: [id])
  kind           String
  amountUzs      Int
  status         String
  paymeTxId      String?           @db.Uuid
  paymeTx        PaymeTransaction? @relation(fields: [paymeTxId], references: [id])
  issuedAt       DateTime          @default(now())
  paidAt         DateTime?

  @@index([teacherId, status])
  @@index([groupId, studentId, status])
  // Revenue dashboard: paid invoices per teacher, newest first. The `paidAt`
  // sort key is descending so the index serves the trailing-N-days lookup
  // without a sort step (Task 24.2).
  @@index([teacherId, status, paidAt(sort: Desc)])
}

model PaymeTransaction {
  id             String       @id @default(uuid()) @db.Uuid
  paymeId        String?      @unique
  account        Json
  amountUzs      Int
  state          PaymeTxState @default(PENDING)
  createTime     BigInt?
  performTime    BigInt?
  cancelTime     BigInt?
  reason         Int?
  rawPayload     Json?
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoices Invoice[]

  @@index([state, createdAt])
}

// ============ CATALOG ============

model Course {
  id             String         @id @default(uuid()) @db.Uuid
  teacherId      String         @db.Uuid
  teacher        TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  title          String
  description    String?
  level          String?
  cefrLevel      CefrLevel?
  examTrack      String?
  coverUrl       String?
  isPublished    Boolean        @default(false)
  isDiscoverable Boolean        @default(true)
  fromPriceUzs   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  groups Group[]

  @@index([teacherId, isPublished])
  @@index([isPublished, isDiscoverable])
}

model Group {
  id             String    @id @default(uuid()) @db.Uuid
  courseId       String    @db.Uuid
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name           String
  cefrLevel      CefrLevel?
  priceUzs       Int       @default(0)
  capacity       Int?
  startsOn       DateTime?
  endsOn         DateTime?
  status         String    @default("OPEN")
  isDiscoverable Boolean   @default(true)
  /// Content-protection Download_Permission (content-protection-backend, Req 4.5).
  /// Server-authoritative: when false, learners may only stream restricted files
  /// inline, never download them as an attachment.
  downloadAllowed Boolean  @default(false)
  joinCode       String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schedule           Schedule?
  scheduleExceptions ScheduleException[]
  lessons            Lesson[]
  inviteLinks        InviteLink[]
  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  invoices           Invoice[]
  modules            GroupModule[]

  @@index([courseId, status])
  @@index([status, isDiscoverable])
}

/// Per-Group module toggle. Seeded from SpecialtyModule catalog on Group creation.
model GroupModule {
  groupId    String             @db.Uuid
  group      Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  moduleType HomeworkModuleType
  isEnabled  Boolean            @default(false)
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@id([groupId, moduleType])
  @@index([groupId, isEnabled])
}

model Schedule {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @unique @db.Uuid
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
