// ============ KEY MANAGEMENT (Task 28.2) ============

/// Lifecycle status of an at-rest data-encryption key (DEK).
///
/// Only one row per process is ever `ACTIVE` — newly written
/// envelopes always reference that row's id. After a rotation the
/// previous active row is moved to `RETIRED`; rows remain readable
/// (and their key material loadable into the in-memory key
/// manager) until every envelope referencing them has been
/// re-encrypted by `ReencryptProcessor` (Task 28.2).
enum EncryptionKeyStatus {
  ACTIVE
  RETIRED
  SHREDDED
}

/// EncryptionKey — Task 28.2.
///
/// A single 32-byte AES-256 data key wrapped (envelope-encrypted)
/// by the master key from `MASTER_ENCRYPTION_KEY` / `MASTER_KEY`.
/// The wrapped material is stored as a string envelope produced by
/// `EncryptionService` so the master key never touches the database.
///
/// Rotation (zero-downtime):
///   1. `KeyManagementService.rotate()` creates a new row with
///      `status = ACTIVE`; the previous active row flips to
///      `RETIRED` and `rotatedToId` points to the new row.
///   2. Subsequent encrypts use the new key (new envelopes embed
///      the new key id).
///   3. `ReencryptProcessor` walks every column listed in
///      `DEFAULT_ENCRYPTED_FIELDS` in batches and re-encrypts rows
///      whose envelopes still reference the retired key id.
///   4. Once no envelopes reference the retired key, an operator
///      can prune the row (the key material is then unrecoverable —
///      crypto-shredding posture, Req 28.7).
///
/// `keyMaterial` is intentionally a `String` (not `Bytes`) so
/// callers can store the wrapped envelope verbatim without any
/// further encoding. Reading the row never yields raw key bytes —
/// the unwrap step happens inside `KeyManagementService`.
// ============ AI CHAT CONVERSATIONS ============

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Yangi suhbat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // 'user' | 'assistant'
  content        String
  attachments    Json?          // [{ name, type, size, url?, assetId? }]
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model EncryptionKey {
  id           String              @id @default(cuid())
  /// Wrapped key material (envelope encrypted by the master key).
  /// Plaintext key bytes never appear in the database.
  /// When the row is SHREDDED (Task 28.3, Req 28.7) this column is
  /// reset to the empty string so the per-user key is provably
  /// unrecoverable from the database alone.
  keyMaterial  String
  status       EncryptionKeyStatus @default(ACTIVE)
  /// Forward pointer set when this key is retired and superseded
  /// by another key. Null while the key is active.
  rotatedToId  String?
  /// Owning user for per-user keys (Task 28.3, Req 28.7). NULL for
  /// the platform-wide DEK rotated by `KeyManagementService`. When
  /// set, the key is used to encrypt that user's PII columns and
  /// can be crypto-shredded by `CryptoShredService` to make all of
  /// that user's at-rest ciphertext permanently undecryptable.
  userId       String?             @db.Uuid
  shreddedAt   DateTime?
  createdAt    DateTime            @default(now())
  retiredAt    DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}
